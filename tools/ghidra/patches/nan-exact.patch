+/// \class RuleFloatCompareTable
+/// \brief (spore-decomp patch) see ruleaction.hh
+///
+/// Outcome bits: 1=LT (a<b), 2=EQ, 4=GT, 8=UNa (only a NaN), 16=UNb (only b NaN), 32=UNab (both NaN).
+void RuleFloatCompareTable::getOpList(vector<uint4> &oplist) const
+
+{
+  uint4 list[] = { CPUI_BOOL_OR, CPUI_BOOL_AND, CPUI_BOOL_NEGATE, CPUI_BOOL_XOR, CPUI_INT_EQUAL, CPUI_INT_NOTEQUAL };
+  oplist.insert(oplist.end(),list,list+6);
+}
+
+/// \return the 6-bit truth table of the boolean Varnode, or -1 if it is not a combination over a single pair
+int4 RuleFloatCompareTable::evalTable(Varnode *vn,Pair &pr,int4 depth,int4 &nanLeaves,int4 &cmpLeaves)
+
+{
+  const int4 ALL = 63;
+  if (vn->isConstant()) {
+    if (vn->getSize() != 1) return -1;
+    return (vn->getOffset() == 0) ? 0 : ALL;
+  }
+  if (!vn->isWritten() || depth > 10) return -1;
+  PcodeOp *op = vn->getDef();
+  OpCode opc = op->code();
+  switch(opc) {
+  case CPUI_FLOAT_NAN: {
+    Varnode *x = op->getIn(0);
+    if (pr.a == (Varnode *)0) return -1;	// a compare must be seen first to fix the pair
+    nanLeaves += 1;
+    if (functionalEquality(x,pr.a)) return 8 | 32;
+    if (functionalEquality(x,pr.b)) return 16 | 32;
+    return -1;
+  }
+  case CPUI_FLOAT_LESS:
+  case CPUI_FLOAT_LESSEQUAL:
+  case CPUI_FLOAT_EQUAL:
+  case CPUI_FLOAT_NOTEQUAL: {
+    Varnode *x = op->getIn(0);
+    Varnode *y = op->getIn(1);
+    if (pr.a == (Varnode *)0) { pr.a = x; pr.b = y; }
+    bool fwd;
+    if (functionalEquality(x,pr.a) && functionalEquality(y,pr.b)) fwd = true;
+    else if (functionalEquality(x,pr.b) && functionalEquality(y,pr.a)) fwd = false;
+    else return -1;
+    cmpLeaves += 1;
+    int4 lt = fwd ? 1 : 4;			// x<y in terms of (a,b)
+    int4 gt = fwd ? 4 : 1;
+    if (opc == CPUI_FLOAT_LESS) return lt;
+    if (opc == CPUI_FLOAT_LESSEQUAL) return lt | 2;
+    if (opc == CPUI_FLOAT_EQUAL) return 2;
+    return lt | gt | 8 | 16 | 32;		// NOTEQUAL is true when unordered
+  }
+  case CPUI_BOOL_NEGATE: {
+    int4 t = evalTable(op->getIn(0),pr,depth+1,nanLeaves,cmpLeaves);
+    return (t < 0) ? -1 : (ALL & ~t);
+  }
+  case CPUI_COPY:
+    return evalTable(op->getIn(0),pr,depth+1,nanLeaves,cmpLeaves);
+  case CPUI_BOOL_OR:
+  case CPUI_BOOL_AND:
+  case CPUI_BOOL_XOR:
+  case CPUI_INT_EQUAL:
+  case CPUI_INT_NOTEQUAL: {
+    if (op->getIn(0)->getSize() != 1) return -1;
+    // evaluate a compare-containing side first so the pair gets fixed before NaN leaves
+    int4 t0 = evalTable(op->getIn(0),pr,depth+1,nanLeaves,cmpLeaves);
+    int4 t1 = evalTable(op->getIn(1),pr,depth+1,nanLeaves,cmpLeaves);
+    if (t0 < 0 && pr.a != (Varnode *)0) t0 = evalTable(op->getIn(0),pr,depth+1,nanLeaves,cmpLeaves);
+    if (t0 < 0 || t1 < 0) return -1;
+    if (opc == CPUI_BOOL_OR) return t0 | t1;
+    if (opc == CPUI_BOOL_AND) return t0 & t1;
+    if (opc == CPUI_BOOL_XOR || opc == CPUI_INT_NOTEQUAL) return (t0 ^ t1) & ALL;
+    return ALL & ~(t0 ^ t1);
+  }
+  default:
+    break;
+  }
+  return -1;
+}
+
+int4 RuleFloatCompareTable::applyOp(PcodeOp *op,Funcdata &data)
+
+{
+  if (op->getOut()->getSize() != 1) return 0;
+  Pair pr; pr.a = (Varnode *)0; pr.b = (Varnode *)0;
+  int4 nanLeaves = 0, cmpLeaves = 0;
+  int4 t = evalTable(op->getOut(),pr,0,nanLeaves,cmpLeaves);
+  if (t < 0 || pr.a == (Varnode *)0) return 0;
+  if (nanLeaves == 0 && cmpLeaves < 2) return 0;	// already a single compare (possibly negated)
+  // NaN cases must agree (the expression only distinguishes "unordered"), unless one side is a constant
+  bool aConst = pr.a->isConstant(), bConst = pr.b->isConstant();
+  int4 ord = t & 7;
+  bool un;
+  int4 una = (t >> 3) & 1, unb = (t >> 4) & 1, unab = (t >> 5) & 1;
+  if (aConst && bConst) return 0;
+  if (bConst) un = una;
+  else if (aConst) un = unb;
+  else {
+    if (una != unb || una != unab) return 0;
+    un = una;
+  }
+  OpCode newop; bool swap = false, negate = false;
+  int4 key = ord | (un ? 8 : 0);
+  switch(key) {
+  case 1: newop = CPUI_FLOAT_LESS; break;			// a <  b
+  case 4: newop = CPUI_FLOAT_LESS; swap = true; break;		// b <  a
+  case 2: newop = CPUI_FLOAT_EQUAL; break;			// a == b
+  case 3: newop = CPUI_FLOAT_LESSEQUAL; break;			// a <= b
+  case 6: newop = CPUI_FLOAT_LESSEQUAL; swap = true; break;	// b <= a
+  case 13: newop = CPUI_FLOAT_NOTEQUAL; break;			// a != b
+  case 1|8: newop = CPUI_FLOAT_LESSEQUAL; swap = true; negate = true; break;	// !(b <= a)
+  case 4|8: newop = CPUI_FLOAT_LESSEQUAL; negate = true; break;			// !(a <= b)
+  case 3|8: newop = CPUI_FLOAT_LESS; swap = true; negate = true; break;		// !(b <  a)
+  case 6|8: newop = CPUI_FLOAT_LESS; negate = true; break;			// !(a <  b)
+  default: return 0;				// no single exact C comparison
+  }
+  Varnode *x = swap ? pr.b : pr.a;
+  Varnode *y = swap ? pr.a : pr.b;
+  if (!negate) {
+    data.opSetOpcode(op,newop);
+    if (op->numInput() == 1) data.opInsertInput(op,y,1);
+    data.opSetInput(op,x,0);
+    data.opSetInput(op,y,1);
+  }
+  else {
+    PcodeOp *cmp = data.newOp(2,op->getAddr());
+    data.opSetOpcode(cmp,newop);
+    data.opSetInput(cmp,x,0);
+    data.opSetInput(cmp,y,1);
+    Varnode *cmpOut = data.newUniqueOut(1,cmp);
+    data.opInsertBefore(cmp,op);
+    if (op->numInput() == 2) data.opRemoveInput(op,1);
+    data.opSetOpcode(op,CPUI_BOOL_NEGATE);
+    data.opSetInput(op,cmpOut,0);
+  }
+  return 1;
+}
