+/// \class RuleFloatAndChain
+/// \brief (spore-decomp patch) Exact simplification of floating-point AND-chains (see ruleaction.hh)
+void RuleFloatAndChain::getOpList(vector<uint4> &oplist) const
+
+{
+  oplist.push_back(CPUI_BOOL_AND);
+}
+
+int4 RuleFloatAndChain::applyOp(PcodeOp *op,Funcdata &data)
+
+{
+  // Only start at the root of an AND-tree
+  PcodeOp *rd = op->getOut()->loneDescend();
+  if (rd != (PcodeOp *)0 && rd->code() == CPUI_BOOL_AND) return 0;
+  // Collect (parent op, slot) for every leaf term of the tree
+  vector<pair<PcodeOp *,int4> > terms;
+  vector<PcodeOp *> stack;
+  stack.push_back(op);
+  while(!stack.empty() && terms.size() < 32) {
+    PcodeOp *cur = stack.back(); stack.pop_back();
+    for(int4 i=0;i<2;++i) {
+      Varnode *vn = cur->getIn(i);
+      if (vn->isWritten() && vn->getDef()->code() == CPUI_BOOL_AND && vn->loneDescend() == cur)
+	stack.push_back(vn->getDef());
+      else
+	terms.push_back(pair<PcodeOp *,int4>(cur,i));
+    }
+  }
+  vector<PcodeOp *> ordered;	// ordered compares in the chain
+  for(int4 i=0;i<terms.size();++i) {
+    Varnode *vn = terms[i].first->getIn(terms[i].second);
+    if (!vn->isWritten()) continue;
+    OpCode c = vn->getDef()->code();
+    if (c == CPUI_FLOAT_LESS || c == CPUI_FLOAT_LESSEQUAL || c == CPUI_FLOAT_EQUAL)
+      ordered.push_back(vn->getDef());
+  }
+  if (ordered.empty()) return 0;
+  int4 count = 0;
+  for(int4 i=0;i<terms.size();++i) {
+    PcodeOp *parent = terms[i].first;
+    int4 slot = terms[i].second;
+    Varnode *vn = parent->getIn(slot);
+    if (!vn->isWritten()) continue;
+    PcodeOp *def = vn->getDef();
+    if (def->code() == CPUI_BOOL_NEGATE && def->getIn(0)->isWritten() &&
+	def->getIn(0)->getDef()->code() == CPUI_FLOAT_NAN) {
+      Varnode *x = def->getIn(0)->getDef()->getIn(0);
+      for(int4 j=0;j<ordered.size();++j) {
+	if (functionalEquality(x,ordered[j]->getIn(0)) || functionalEquality(x,ordered[j]->getIn(1))) {
+	  data.opSetInput(parent,data.newConstant(1,1),slot);	// !NAN(x) is implied by the ordered compare
+	  count += 1;
+	  break;
+	}
+      }
+    }
+    else if (def->code() == CPUI_FLOAT_NOTEQUAL) {
+      for(int4 j=0;j<ordered.size();++j) {
+	PcodeOp *le = ordered[j];
+	if (le->code() != CPUI_FLOAT_LESSEQUAL) continue;
+	bool same = (functionalEquality(le->getIn(0),def->getIn(0)) && functionalEquality(le->getIn(1),def->getIn(1))) ||
+	  (functionalEquality(le->getIn(0),def->getIn(1)) && functionalEquality(le->getIn(1),def->getIn(0)));
+	if (!same || le->getOut()->loneDescend() == (PcodeOp *)0) continue;
+	data.opSetOpcode(le,CPUI_FLOAT_LESS);			// a <= b && a != b  ->  a < b
+	data.opSetInput(parent,data.newConstant(1,1),slot);
+	count += 1;
+	break;
+      }
+    }
+  }
+  return (count > 0) ? 1 : 0;
+}
