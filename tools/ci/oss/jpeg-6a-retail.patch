--- a/jcmarker.c
+++ b/jcmarker.c
@@ -94,4 +94,11 @@
  */
 
+/* Spore patch: the AVI1-marker selector lives at +0x168 of jpeg_compress_struct,
+ * past the end of the upstream 6a struct (sizeof == 0x168); it is set to 1 by
+ * jpeg_CreateCompress and cleared by the AVI1 writer for video JPEGs.  Read as a
+ * raw word so the field layout of the rest of the struct stays upstream's. */
+#define AVI1_FLAG(cinfo)  (*(int *) ((char *) (cinfo) + 0x168))
+
+
 LOCAL(void)
 emit_byte (j_compress_ptr cinfo, int val)
@@ -126,4 +133,16 @@
 
 
+/* Spore patch: upstream 6a has no 4-byte emitter; the binary does (0x00853320). */
+LOCAL(void)
+emit_4bytes (j_compress_ptr cinfo, int value)
+/* Emit a 4-byte integer, MSB first */
+{
+  emit_byte(cinfo, (value >> 24) & 0xFF);
+  emit_byte(cinfo, (value >> 16) & 0xFF);
+  emit_byte(cinfo, (value >> 8) & 0xFF);
+  emit_byte(cinfo, value & 0xFF);
+}
+
+
 /*
  * Routines to write specific marker types.
@@ -374,4 +393,34 @@
 
 LOCAL(void)
+emit_avi1_app0 (j_compress_ptr cinfo)
+/* Emit the Spore AVI1 video APP0 marker (upstream 6a has no counterpart) */
+{
+  /*
+   * Length of APP0 block	(2 bytes)
+   * Block ID			(4 bytes - ASCII "AVI1")
+   * Zero byte			(1 byte to terminate the ID string)
+   * Padding			(1 byte)
+   * Frame counts / rates	(8 bytes - four big-endian longs)
+   *
+   * Written verbatim from the binary (0x00853c80): length 0x10, the ASCII tag
+   * "AVI1", a zero byte, then two 4-byte zero fields.
+   */
+  
+  emit_marker(cinfo, M_APP0);
+  
+  emit_2bytes(cinfo, 2 + 4 + 1 + 1 + 4 + 4); /* length */
+
+  emit_byte(cinfo, 0x41);	/* Identifier: ASCII "AVI1" */
+  emit_byte(cinfo, 0x56);
+  emit_byte(cinfo, 0x49);
+  emit_byte(cinfo, 0x31);
+  emit_byte(cinfo, 0);
+  emit_byte(cinfo, 0);
+  emit_4bytes(cinfo, 0);
+  emit_4bytes(cinfo, 0);
+}
+
